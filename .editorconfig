root = true

# Only hand-written source and docs are covered. Generated and binary files are left as they are.

[*.{cpp,h,hpp,inl,hlsl,hlsli}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{py,ps1}]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{vcxproj,filters,props,targets}]
indent_style = space
indent_size = 2

[*.md]
charset = utf-8
insert_final_newline = true

# Vendored code keeps its upstream formatting.
[Source/3rdParty/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset

[Source/{GamePad,Keyboard,Mouse,SimpleMath,PlatformHelpers,ReadData,par_shapes,debug_draw}.*]
end_of_line = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = unset
